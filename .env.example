# =============================
# 채팅 API Mock 모드 설정
# =============================

# Mock 모드 활성화 (데모용 - 백엔드 없이 동작)
# true: Mock 모드 (백엔드 없이 동작, 대화 시나리오 자동 진행)
# false: Real 모드 (실제 백엔드 API 호출)
VITE_USE_MOCK=true

# 백엔드 API URL (Real 모드일 때만 사용됨)
VITE_BACKEND=http://localhost:8080

# =============================
# 사용 방법
# =============================
# 1. 이 파일을 .env로 복사하세요:
#    cp .env.example .env
#
# 2. 데모 녹화 시 (백엔드 없이):
#    VITE_USE_MOCK=true
#
# 3. 실제 백엔드 연동 시:
#    VITE_USE_MOCK=false
#    VITE_BACKEND=https://your-api-server.com
